{
  "id": "browser-mcp",
  "name": "browser-mcp",
  "display_name": "Playwright MCP",
  "type": "mcp",
  "description": "Official Microsoft Playwright MCP server for browser automation through accessible page snapshots and browser actions.",
  "category": "Browser Automation",
  "version": "0.0.83",
  "author": {
    "name": "Microsoft Corporation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/the-mayankjha/browser-mcp",
    "branch": "main"
  },
  "runtime": {
    "type": "node"
  },
  "transport": {
    "type": "stdio"
  },
  "requirements": [
    "Node.js 18 or newer"
  ],
  "tools": [
    {
      "name": "browser_navigate",
      "description": "Navigate to a URL."
    },
    {
      "name": "browser_navigate_back",
      "description": "Go back in browser history."
    },
    {
      "name": "browser_snapshot",
      "description": "Capture the current page accessibility snapshot."
    },
    {
      "name": "browser_find",
      "description": "Find text or patterns in the page snapshot."
    },
    {
      "name": "browser_click",
      "description": "Click a page element."
    },
    {
      "name": "browser_hover",
      "description": "Hover over a page element."
    },
    {
      "name": "browser_drag",
      "description": "Drag and drop between page elements."
    },
    {
      "name": "browser_type",
      "description": "Type text into a page element."
    },
    {
      "name": "browser_fill_form",
      "description": "Fill multiple form fields."
    },
    {
      "name": "browser_select_option",
      "description": "Select dropdown options."
    },
    {
      "name": "browser_press_key",
      "description": "Press a keyboard key."
    },
    {
      "name": "browser_take_screenshot",
      "description": "Capture a page screenshot."
    },
    {
      "name": "browser_handle_dialog",
      "description": "Accept or dismiss a browser dialog."
    },
    {
      "name": "browser_tabs",
      "description": "List and manage open tabs."
    },
    {
      "name": "browser_close",
      "description": "Close the current page."
    }
  ],
  "tool_count": 15,
  "installation": {
    "type": "archive",
    "entrypoint": "node_modules/@playwright/mcp/cli.js"
  },
  "artifacts": [],
  "compatibility": {
    "minimum_pihu_version": "1.2.8",
    "operating_systems": [
      "macos",
      "windows",
      "linux"
    ],
    "architectures": [
      "arm64",
      "x64"
    ]
  },
  "permissions": {
    "network": true,
    "filesystem": true,
    "shell_execution": false,
    "env_vars_required": []
  },
  "auth_required": false,
  "entrypoint": {
    "command": "node",
    "args": [
      "--browser",
      "chrome"
    ],
    "env": {}
  }
}
